# Postgres connection string (for example from Neon or Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Admin area (/admin) uses HTTP basic auth.
# HASHED_ADMIN_PASSWORD is the base64 SHA-512 of the password:
#   node -e "console.log(require('crypto').createHash('sha512').update('YOUR_PASSWORD').digest('base64'))"
ADMIN_USERNAME=admin
HASHED_ADMIN_PASSWORD=

# Stripe (use test keys: sk_test_..., pk_test_..., whsec_...)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (receipt and order-history emails)
RESEND_API_KEY=
SENDER_EMAIL=

# Public base URL of this deployment, used in emailed links and Stripe return URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
