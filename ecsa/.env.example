# Postgres connection string (for example from Neon or Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Admin area (/admin) uses HTTP basic auth.
# HASHED_ADMIN_PASSWORD is the base64 SHA-512 of the password:
#   node -e "console.log(require('crypto').createHash('sha512').update('YOUR_PASSWORD').digest('base64'))"
ADMIN_USERNAME=admin
HASHED_ADMIN_PASSWORD=

# Resend (optional: only used by the "email my order history" form; leave empty for the demo)
RESEND_API_KEY=
SENDER_EMAIL=

# Vercel Blob token for uploads (added automatically when a Blob store is connected on Vercel).
# Leave empty locally to store files on disk.
BLOB_READ_WRITE_TOKEN=

# Public base URL of this deployment, used in emailed links
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
